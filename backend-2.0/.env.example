# ============================================
# BACKEND Environment Variables
# ============================================

# Server Port (default: 900)
PORT=5002

# MongoDB Connection (REQUIRED - set one of these)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/medtrack
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/medtrack

# JWT Secret (REQUIRED - use a strong random string, min 32 chars)
JWT_SECRET=your-strong-random-secret-min-32-characters

# CORS Origins (comma-separated, for production)
CORS_ORIGINS=https://your-frontend-url.onrender.com

# Brevo Email API Key (optional - for email notifications)
# BREVO_KEY=your-brevo-api-key

# Cloudinary (optional - for image uploads)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Node Environment
NODE_ENV=production
