#!/bin/sh
# Pre-commit hook to prevent committing sensitive data

# Check for sensitive patterns
SENSITIVE_PATTERNS=(
    "password\s*=\s*['\"][^'\"]+['\"]"
    "secret\s*=\s*['\"][^'\"]+['\"]"
    "api[_-]?key\s*=\s*['\"][^'\"]+['\"]"
    "mongodb\+srv://[^@]+@"
    "Bearer\s+[A-Za-z0-9-_=]+\.[A-Za-z0-9-_=]+\.[A-Za-z0-9-_.+/=]+"
)

# Check for .env files being committed
if git diff --cached --name-only | grep -E "^\.env$|^\.env\." | grep -v "\.example$"; then
    echo "ERROR: Attempting to commit .env file(s). This is not allowed."
    echo "Add sensitive files to .gitignore"
    exit 1
fi

# Check for hardcoded secrets in staged files
for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    if git diff --cached | grep -iE "$pattern"; then
        echo "WARNING: Possible sensitive data detected matching pattern: $pattern"
        echo "Please review your changes before committing."
        # Uncomment the next line to block the commit
        # exit 1
    fi
done

# Run linting (if available)
if [ -f "package.json" ] && grep -q "\"lint\"" package.json; then
    npm run lint --silent 2>/dev/null || true
fi

exit 0
